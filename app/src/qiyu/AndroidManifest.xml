<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-feature android:glEsVersion="0x00030001"/>
    <uses-feature android:name="android.hardware.vr.headtracking" android:version="1" android:required="true" />

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- The Qiyu system shows 2D panels via Presentation (OffscreenDisplay), which needs WAKE_LOCK. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" tools:node="replace" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR" />
    <uses-permission android:name="org.khronos.openxr.permission.OPENXR_SYSTEM" />

    <queries>
        <provider android:authorities="org.khronos.openxr.runtime_broker;org.khronos.openxr.system_runtime_broker" />
        <intent>
            <action android:name="org.khronos.openxr.OpenXRRuntimeService" />
        </intent>
        <intent>
            <action android:name="org.khronos.openxr.OpenXRApiLayerService" />
        </intent>
        <!-- Passthrough: the system see-through service and its VST status provider. -->
        <package android:name="com.qiyi.seethroughservice" />
        <provider android:authorities="com.iqiyi.vr.provider" />
    </queries>

    <application>
        <activity
            android:name=".VRBrowserActivity"
            android:screenOrientation="landscape">
            <meta-data
                android:name="android.app.lib_name"
                android:value="native-lib" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Qiyu launcher uses com.yvr.intent.category.VR to launch apps in VR mode
                     (see the working Qiyu OpenXR reference build). IMMERSIVE_HMD is the
                     standard OpenXR category and is kept for generic runtime brokers. -->
                <category android:name="com.yvr.intent.category.VR" />
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
